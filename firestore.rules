rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidBotState(data) {
      return data.keys().hasAll(['cumulativeLoss', 'sessionPnL', 'isRunning', 'globalCurrentStake', 'userId']) &&
             data.cumulativeLoss is number &&
             data.sessionPnL is number &&
             data.isRunning is bool &&
             data.globalCurrentStake is number &&
             data.userId == request.auth.uid &&
             (data.get('lastLostSymbol', '') is string) &&
             (data.get('updatedAt', request.time) == request.time);
    }

    function isValidBotSettings(data) {
      return data.keys().hasAll(['apiToken', 'globalStake', 'targetStreak', 'takeProfit', 'stopLoss', 'useSchedule', 'userId']) &&
             data.apiToken is string && data.apiToken.size() <= 200 &&
             data.globalStake is number &&
             data.targetStreak is number &&
             data.takeProfit is number &&
             data.stopLoss is number &&
             data.useSchedule is bool &&
             data.userId == request.auth.uid &&
             (data.get('startTime', '') is string) &&
             (data.get('stopTime', '') is string) &&
             (data.get('updatedAt', request.time) == request.time);
    }

    function isValidTradeLog(data) {
      return data.keys().hasAll(['tradeId', 'timestamp', 'market', 'contractId', 'buyPrice', 'result', 'pnl', 'userId']) &&
             data.tradeId is string && data.tradeId.size() <= 128 &&
             data.timestamp is number &&
             data.market is string && data.market.size() <= 64 &&
             data.contractId is number &&
             data.buyPrice is number &&
             data.result in ['won', 'lost', 'pending'] &&
             data.pnl is number &&
             data.userId == request.auth.uid;
    }

    match /botStates/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidBotState(incoming());
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidBotState(incoming()) && incoming().userId == existing().userId;
    }

    match /botSettings/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidBotSettings(incoming());
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidBotSettings(incoming()) && incoming().userId == existing().userId;
      
      match /trades/{tradeId} {
        allow get: if isSignedIn() && request.auth.uid == userId;
        allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
        allow create: if isSignedIn() && isValidId(userId) && isValidId(tradeId) && request.auth.uid == userId && isValidTradeLog(incoming());
        allow update: if isSignedIn() && isValidId(userId) && isValidId(tradeId) && request.auth.uid == userId && isValidTradeLog(incoming()) && incoming().userId == existing().userId;
      }
    }
  }
}
