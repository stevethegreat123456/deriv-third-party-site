rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /bot_data/{dataId} {
      allow read, write: if true;
    }

    match /bot_trades/{tradeId} {
      allow read, write: if true;
    }
  }
}
