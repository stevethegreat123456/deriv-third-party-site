{
  "entities": {
    "BotState": {
      "title": "BotState",
      "description": "Represents the active state of the bot on the server",
      "type": "object",
      "properties": {
        "cumulativeLoss": { "type": "number", "description": "The current cumulative loss for martingale recovery" },
        "sessionPnL": { "type": "number", "description": "The current session overall PnL" },
        "isRunning": { "type": "boolean" },
        "globalCurrentStake": { "type": "number" },
        "lastLostSymbol": { "type": "string" },
        "userId": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["cumulativeLoss", "sessionPnL", "isRunning", "globalCurrentStake", "userId"]
    },
    "BotSettings": {
      "title": "BotSettings",
      "description": "User configuration for the bot",
      "type": "object",
      "properties": {
        "apiToken": { "type": "string" },
        "globalStake": { "type": "number" },
        "targetStreak": { "type": "number" },
        "takeProfit": { "type": "number" },
        "stopLoss": { "type": "number" },
        "useSchedule": { "type": "boolean" },
        "startTime": { "type": "string" },
        "stopTime": { "type": "string" },
        "userId": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["apiToken", "globalStake", "targetStreak", "takeProfit", "stopLoss", "useSchedule", "userId"]
    },
    "TradeLog": {
      "title": "TradeLog",
      "description": "A ledger of executed trades",
      "type": "object",
      "properties": {
        "tradeId": { "type": "string" },
        "timestamp": { "type": "number" },
        "market": { "type": "string" },
        "contractId": { "type": "number" },
        "buyPrice": { "type": "number" },
        "result": { "type": "string", "enum": ["won", "lost", "pending"] },
        "pnl": { "type": "number" },
        "userId": { "type": "string" }
      },
      "required": ["tradeId", "timestamp", "market", "contractId", "buyPrice", "result", "pnl", "userId"]
    }
  },
  "firestore": {
    "/botStates/{userId}": {
      "schema": { "$ref": "#/entities/BotState" },
      "description": "Active state for a user's bot"
    },
    "/botSettings/{userId}": {
      "schema": { "$ref": "#/entities/BotSettings" },
      "description": "Settings for a user's bot"
    },
    "/botSettings/{userId}/trades/{tradeId}": {
      "schema": { "$ref": "#/entities/TradeLog" },
      "description": "Ledger of executed trades"
    }
  }
}
